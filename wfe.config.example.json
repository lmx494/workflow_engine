{
  "_comment": "复制为 wfe.config.json 使用。providers 只写引用，密钥放 keys.local.json。",
  "providers": [
    { "id": "local", "baseUrl": "http://127.0.0.1:8326/v1", "apiKeyFile": "~/.dsh/openai-gateway/api-key" },
